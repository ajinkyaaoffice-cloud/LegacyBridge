# Copy to .env and fill in the keys you have. All are FREE tiers; none needs a credit card
# except where noted in config/providers.yaml. Missing keys => that provider is skipped.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys  (use only ':free' models)
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys  (Experiment plan, phone verification)
CEREBRAS_API_KEY=      # disabled by default: free tier became a card-gated trial (2026-07)

# ---- website (`legacybridge web`), optional ---------------------------------------------------
# Supabase: hosted sign-in (e-mail + "Continue with GitHub") and a mirror of profiles/runs.
# Leave empty to keep local punch-card accounts only. Schema: supabase/schema.sql.
# GitHub sign-in: enable the GitHub provider in Supabase Auth and add <site>/app to its redirect URLs.
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_ANON_KEY=            # public anon key (sent to the browser; RLS protects the tables)
SUPABASE_SERVICE_ROLE_KEY=    # server only, never sent to the browser; enables the ledger mirror
